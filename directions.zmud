{
    #VAR {githFound}{0};
    #VAR {findGith}{1};
    #MATH githX 0;
    #MATH githY 0;
    #MATH githZ 0;
    gotoastral;
    #SHOW {@GOkay!@w Travelling to @YGith@w!};
    #DELAY {2}
    {
        #IF {!$travelerror}
        {
            north;north;north;north;north;exits;
