#ALIAS {helpShade}
{
    #SHOW {@Y************************@C Help Shade @Y************************@w};
    #SHOW {@YgotoShadeRebel - To Rebel Leader From Tiltin@w: };
    #SHOW {    d;e;s;d;d;d;s;e;n;n;n;n;bash stone d;d;s;w;w;d;w;n;n;w;w;n;d;w;s;d;s;u;w};
    #SHOW {@YgotoShadeSelset - To Selset from Rebel Leader@w: e;d;n;u;e;bash cage n};
    #SHOW {@Y************************************************************@w};
}

#ALIAS {gotoShadeRebel}
{
    where;
    #DELAY {2}
    {
        #IF {$currentRoom = "The Top of the Tower"}
        {
            #SHOW {@GOkay!@w Travelling to @YShade Rebel@w!};
            fly;d;e;s;d;d;d;s;e;n;n;n;n;bash stone d;d;s;w;w;d;w;n;n;w;w;n;d;w;s;d;s;u;w;
        };
        #ELSE
        {
            #SHOW {@RError@w: You're not in the correct room 'The Top of the Tower'!}
        };
    };
}

#ALIAS {gotoShadeSelset}
{
    where;
        #DELAY {2}
    {
        #IF {$currentRoom = "In the Catacombs"}
        {
            #SHOW {@GOkay!@w Travelling to @YShade Selset@w!};
            fly;e;d;n;u;e;bash cage n;
        };
        #ELSE
        {
            #SHOW {@RError@w: You're not in the correct room 'In the Catacombs'!}
        };
    };
}

