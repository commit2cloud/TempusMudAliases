#ALIAS {travel %1 %2} {
	#VAR {travelInput1} @lower(%1);

	#IF {$travelInput1 = "past" || %1 = 1} 
	{
		#SWITCH {"%2"} {
			#CASE {"1"} { gotoAbandonedKeep; };
			#CASE {"2"} { gotoOldMonastery; };
		    #CASE {"3"} { gotoCastleSlivendark; };
			#CASE {"4"} { gotoChessboardOfAraken; };
			#CASE {"5"} { gotoDismalDelve; };
			#CASE {"6"} { gotoDraconiansAndDragonHighlord; };
			#CASE {"7"} { gotoDukeAraken; };
			#CASE {"8"} { gotoElvenVillage; };
			#CASE {"9"} { gotoForgottenValley; };
			#CASE {"10"} { gotoFontOfModrian; };
			#CASE {"11"} { gotoFrozenTundras; };
			#CASE {"12"} { gotoGlacialRift; };
			#CASE {"13"} { gotoGreatPyramid };
			#CASE {"14"} { gotoGuiharianFestivalOfLights; };
			#CASE {"15"} { gotoHalflingVillage; };
			#CASE {"16"} { gotoHarpellHouse; };
			#CASE {"17"} { gotoHighTowerOfMagic; };
			#CASE {"18"} { gotoHillGiantSteading; };
			#CASE {"19"} { gotoHobgoblins; };
			#CASE {"20"} { gotoHolyGrail; };
			#CASE {"21"} { gotoIstan; };
			#CASE {"22"} { gotoKoboldTunnels; };
			#CASE {"23"} { gotoLearander; };
			#CASE {"24"} { gotoCrystalFortress; };
			#CASE {"25"} { gotoMalevolentCircle; };
			#CASE {"26"} { gotoMavernal; };
			#CASE {"27"} { gotoNeverwhere; };
			#CASE {"28"} { gotoOgreEncampment; };
			#CASE {"29"} { gotoOldThalos; };
			#CASE {"30"} { gotoPitFiend; };
			#CASE {"31"} { gotoPoolOfEvil; };
			#CASE {"32"} { gotoReedSwamp; };
			#CASE {"33"} { gotoSewersOfModrian; };
			#CASE {"34"} { gotoShade; };
			#CASE {"35"} { gotoSilverTower; };
			#CASE {"36"} { gotoSolaceCove; };
			#CASE {"37"} { gotoSkullport; };
			#CASE {"38"} { gotoTempleOfAncients; };
			#CASE {"39"} { gotoTowerOfTheRenegadeMage; };
			#CASE {"40"} { gotoTheTreetopsOfArachna; };
			#CASE {"41"} { gotoUndermountain; };
			#CASE {"42"} { gotoWemicPlains; };
			#CASE {"43"} { gotoZhengisCastle; };
			#DEFAULT {
				#VAR {travelerror} {1};
				#SHOW {Invalid Destination Combination '@R%1@w' and '@R%2@w'};
				};
			};
		};

	#ELSEIF {$travelInput1 = "future" || %1 = 2} {
		#SWITCH {"%2"} {
			#CASE {"1"} { gotoAPollutedVillage };
			#CASE {"2"} { gotoArcheologicalDig };
			#CASE {"3"} { gotoBlastedSwamp };
			#CASE {"4"} { gotoColony };
			#CASE {"5"} { gotoCybertechLabs };
			#CASE {"6"} { gotoCybertechPreparatorySchool };
			#CASE {"7"} { gotoDeathRow };
			#CASE {"8"} { gotoDracharnos };
			#CASE {"9"}  { gotoDrugDealer };
			#CASE {"10"} { gotoECJunkyard };
			#CASE {"11"} { gotoECMilitary };
			#CASE {"12"} { gotoECVamps };
			#CASE {"13"} { gotoECNuclearPower };
			#CASE {"14"} { gotoECPowerAndPlumbing };
			#CASE {"15"} { gotoECSecurityCompound };
			#CASE {"16"} { gotoECUniversity };
			#CASE {"17"} { gotoElectronicsSchool };
			#CASE {"18"} { gotoElectronicsShop };
			#CASE {"19"} { gotoFailFamilyLegacy };
			#CASE {"20"} { gotoFassanSlaveCompound };
			#CASE {"21"} { gotoGenCloneBioMechanicalLabs };
			#CASE {"22"} { gotoKiddieKandy };
			#CASE {"23"} { gotoKromguard };
			#CASE {"24"} { gotoLuxare };
			#CASE {"25"} { gotoMerquryCity };
			#CASE {"26"} { gotoNETWORKCommunicationsTower };
			#CASE {"27"} { gotoReinforcer };
			#CASE {"28"} { gotoRuinsOfHTOM };
			#CASE {"29"} { gotoRuinsOfTheSilverTower };
			#CASE {"30"} { gotoSimeonTheCybernetic };
			#CASE {"31"} { gotoTriskinAsylum };
			#CASE {"32"} { gotoVirtualWorldOfNETWORK };
			#CASE {"33"} { gotoZulDane };
			#DEFAULT {
	            #VAR {travelerror} {1};
	    #SHOW {Invalid Destination Combination '@R%1@w' and '@R%2@w'};
	        };
		};
	};

	#ELSEIF {$travelInput1 = "planes" || %1 = 3} 
	{
		#SWITCH {"%2"} 
		{
			#CASE {"1"} { gotoAbyssUnholyModrian; };
			#CASE {"2"} { gotoAmoria; };
			#CASE {"3"} { gotoAvernusHell; };
			#CASE {"4"} { gotoElementalPlaneOfAir; };
			#CASE {"5"} { gotoElementalPlaneOfEarth; };
			#CASE {"6"} { gotoElementalPlaneOfFire; };
			#CASE {"7"} { gotoElementalPlaneOfIce; };
			#CASE {"8"} { gotoElementalPlaneOfOoze; };
			#CASE {"9"} { gotoElementalPlaneOfSmoke; };
			#CASE {"10"} { gotoElementalPlaneOfWater; };
			#CASE {"11"} { gotoLuniaHeaven; };
			#CASE {"12"} { gotoImmoth; };
		   	#CASE {"13"} { gotoCastleMahlhevik; };
			#CASE {"14"} { gotoGith; };
		    #DEFAULT 
			{
				#VAR {travelerror} {1};
				#SHOW {Invalid Destination Combination '@R%1@w' and '@R%2@w'};
			};
		};
	};

		#ELSEIF {$travelInput1 = "trainers" || %1 = 4} {
			#SWITCH {"%2"} {
				#CASE {"1"} { gotoCharismaTrainer;};
				#CASE {"2"} { gotoConstitutionTrainer; };
				#CASE {"3"} { gotoDexterityTrainer; };
				#CASE {"4"} { gotoIntelligenceTrainer; };
				#CASE {"5"} { gotoStrengthTrainer; };
				#CASE {"6"} { gotoWisdomTrainer; };
				#CASE {"7"} { gotoWeaponEnhancer };
				#CASE {"8"} { gotoWeaponSpecializer };
				#CASE {"9"} { gotoWeaponUnSpecializer };
				#CASE {"10"} { gotoGainer };
				#CASE {"11"} { gotoElectronicsSchool };
				#DEFAULT {
					#VAR {travelerror} {1};
			#SHOW {Invalid Destination Combination '@R%1@w' and '@R%2@w'};
				};
			};
		};

		#ELSEIF {$travelInput1 = "guilds" || %1 = 5} {
			#SWITCH {"%2"} {
				#CASE {"1"} { gotoBarbarianGuildmsater;};
				#CASE {"2"} { gotoBardGuildmaster; };
				#CASE {"3"} { gotoClericEvilGuildmaster; };
				#CASE {"4"} { gotoClericGoodGuildmaster; };
				#CASE {"5"} { gotoCyborgGuildmaster; };
				#CASE {"6"} { gotoKnightEvilGuildmaster; };
				#CASE {"7"} { gotoKnightGoodGuildmaster; };
				#CASE {"8"} { gotoMageGuildmaster; };
				#CASE {"9"} { gotoMercenaryGuildmaster; };
				#CASE {"10"} { gotoMonkGuildmaster; };
				#CASE {"11"} { gotoPhysicGuildmaster; };
				#CASE {"12"} { gotoPsionicistGuildmaster; };
				#CASE {"13"} { gotoRangerGuildmaster; };
				#CASE {"14"} { gotoThiefGuildmaster; };
				#DEFAULT {
					#VAR {travelerror} {1};
			#SHOW {Invalid Destination Combination '@R%1@w' and '@R%2@w'};
				};
			};
		};

		#ELSEIF {$travelInput1 = "underdark" || %1 = 6} {
			#SWITCH {"%2"} {
				#CASE {"1"} { gotoHeadShrinker };
				#CASE {"2"} { gotoLizardCaverns };
				#CASE {"3"} { gotoWyllowwood };
				#DEFAULT {
					#VAR {travelerror} {1};
			#SHOW {Invalid Destination Combination '@R%1@w' and '@R%2@w'};
				};
			};
		};

		#ELSEIF {$travelInput1 = "all" || %1 = 7} {
			#NOP //Todo - Use the different lists to formulate a list of available directions
		};

		#ELSE {
			#VAR {travelerror} {1};
		#SHOW {Invalid Planar Destination '@R%1@w'};
		};
	}

	#ALIAS {travel %1} {
		#VAR {travelInput1} @lower(%1);
		#VAR {travelInput1Upper} @upper(%1);
		#IF {debug} {
			#SHOW {Travel Destination: '$travelInput1'};
			#SHOW {Travel Destination Upper: '$travelInput1Upper'};
		};
	        #IF {$travelInput1 = "help" || $travelInput1 = "?"}
		{
	            	#SHOW { @C******************************************************************************************@w };
	            	#SHOW { @C*                                Directions Help!                                        *@w };
	            	#SHOW { @C******************************************************************************************@w };
	            	#SHOW { @C*@w                                                                                        @C*@w};
	            	#SHOW { @C*@C Usage:@w travel <plane> <zone>                                                           @C*@w};
	            	#SHOW { @C*@Y Example:@w travel planes 9                                                               @C*@w};
	            	#SHOW { @C*@w      Travel to the Elemental Plane of Smoke                                            @C*@w};
	            	#SHOW { @C*@Y Example:@w travel 2 15                                                                   @C*@w};
	            	#SHOW { @C*@w      Travel to the Future's EC Universty                                               @C*@w};
	            	#SHOW { @C*@w                                                                                        @C*@w};
	            	#SHOW { @C*@M Recommendations:@w Make an alias in your own scriping config for locations you use       @C*@w };
	            	#SHOW { @C*@w    regularly!                                                                          @C*@w };
	        	#SHOW { @C******************************************************************************************@w };
	        };

		#ELSEIF {$travelInput1 = "past" || %1 = 1}
		{
			#SHOW { @C┌------------------------------------------------------------------------------┐@w };
			#SHOW { @C|                           @CPast Locations@w                                     @C|@w };
			#SHOW { @C├------------------------------------------------------------------------------┤@w };
			#SHOW { @C|  @C1)@w Abandoned Keep       @C2)@w Old Monastery        @C3)@w Castle Slivendark        @C|@w };
			#SHOW { @C|  @C4)@w Chessboard of Araken @C5)@w Dismal Delve         @C6)@w Draconians and Highlords @C|@w };
			#SHOW { @C|  @C7)@w Duke Araken          @C8)@w Elven Village        @C9)@w Forgotten Valley         @C|@w };
			#SHOW { @C| @C10)@w Font of Modrian     @C11)@w Frozen Tundras      @C12)@w Glacial Rift             @C|@w };
			#SHOW { @C| @C13)@w Great Pyramid       @C14)@w Guiharian Festival  @C15)@w Halfling Village         @C|@w };
			#SHOW { @C| @C16)@w Harpell House       @C17)@w High Tower of Magic @C18)@w Hill Giant Steading      @C|@w };
			#SHOW { @C| @C19)@w Hobgoblins          @C20)@w Holy Grail          @C21)@w Istan                    @C|@w };
			#SHOW { @C| @C22)@w Kobold Tunnels      @C23)@w Caves of Learander  @C24)@w Crystal Fortress         @C|@w };
			#SHOW { @C| @C25)@w Malevolent Circle   @C26)@w Mavernal            @C27)@w Neverwhere               @C|@w };
			#SHOW { @C| @C28)@w Ogre Encampment     @C29)@w Old Thalos          @C30)@w Pit Fiend                @C|@w };
			#SHOW { @C| @C31)@w Pool of Evil        @C32)@w Reed Swamp/Lizards  @C33)@w Sewers of Modrian        @C|@w };
			#SHOW { @C| @C34)@w Shade               @C35)@w Silver Tower        @C36)@w Solace Cove              @C|@w };
			#SHOW { @C| @C37)@w Skullport (River)   @C38)@w Temple of Ancients  @C39)@w Tower of Renegade Mage   @C|@w };
			#SHOW { @C| @C40)@w Treetops of Arachna @C41)@w Undermountain       @C42)@w Wemic Plains             @C|@w };
			#SHOW { @C| @C43)@w Zhengi's Castle                                                          @C|@w };
			#SHOW { @C|                                                                              @C|@w };
			#SHOW { @C└------------------------------------------------------------------------------┘@w }; 
		};

		#ELSEIF {$travelInput1 = "future" || %1 = 2}
		{
			#SHOW { @C┌------------------------------------------------------------------------------┐@w };
			#SHOW { @C|                           @CFuture Locations@w                                   @C|@w };
			#SHOW { @C├------------------------------------------------------------------------------┤@w };
			#SHOW { @C|  @C1)@w Polluted Village    @C2)@w Archeolgial Dig      @C3)@w Blasted Swamp             @C|@w };
			#SHOW { @C|  @C4)@w Colony              @C5)@w Cybertech Labs       @C6)@w Cybertech Preparatory     @C|@w };
			#SHOW { @C|  @C7)@w Death Row           @C8)@w Dracharnos           @C9)@w Drug Dealer               @C|@w };
			#SHOW { @C| @C10)@w EC Junkyard        @C11)@w EC Military          @C12)@w EC Vampires              @C|@w };
			#SHOW { @C| @C13)@w EC Nuclear Power   @C14)@w EC Power & Plubming  @C15)@w EC Security Compound     @C|@w };
			#SHOW { @C| @C16)@w EC University      @C17)@w Electronics School   @C18)@w Electronics Shop         @C|@w };
			#SHOW { @C| @C19)@w Fail Family Legacy @C20)@w Fassan Slave Compound@C21)@w GenClone Bio Labs        @C|@w };
			#SHOW { @C| @C22)@w Kiddie Kandy, Inc. @C23)@w Kromguard            @C24)@w Luxare                   @C|@w };
			#SHOW { @C| @C25)@w Merqury City       @C26)@w NETWORK  Tower       @C27)@w Equipment Reinforcer     @C|@w };
			#SHOW { @C| @C28)@w Ruins of HTOM      @C29)@w Silver Tower  Ruins  @C30)@wSimeon the Cybernetic     @C|@w };
			#SHOW { @C| @C31)@w @RTriskin Asylum@w     @C32)@w Virtual  World       @C33)@wZul’Dane                  @C|@w };
			#SHOW { @C|                                                                              @C|@w };
			#SHOW { @C└------------------------------------------------------------------------------┘@w };
		};

		#ELSEIF {$travelInput1 = "planes" || %1 = 3}
		{
			#SHOW { @C┌------------------------------------------------------------------------------┐@w };
			#SHOW { @C|                           @MPlanes Locations@w                                   @C|@w };
			#SHOW { @C├------------------------------------------------------------------------------┤@w };
			#SHOW { @C|  @C1)@w Abyss/Unholy Mod    @C2)@w Amoria                @C3)@w Avernus, Hell Level 1    @C|@w };
			#SHOW { @C|  @C4)@w Plane of Air        @C5)@w Plane of Earth        @C6)@w Plane of Fire            @C|@w };
			#SHOW { @C|  @C7)@w Plane of Ice        @C8)@w Plane of Ooze         @C9)@w Plane of Smoke           @C|@w };
			#SHOW { @C| @C10)@w Plane of Water     @C11)@w Lunia, Heaven Level 1@C12)@wImmoth                    @C|@w };
			#SHOW { @C| @C13)@w Castle Mahlhevik   @C14)@w Githyanki Fortress   @C@w                             @C|@w };
			#SHOW { @C|                                                                              @C|@w };
			#SHOW { @C└------------------------------------------------------------------------------┘@w };
		};
	
		#ELSEIF {$travelInput1 = "trainers" || %1 = 4}
		{
			#SHOW { @C┌------------------------------------------------------------------------------┐@w };
			#SHOW { @C|                          @YTrainers Locations@w                                  @C|@w };
			#SHOW { @C├------------------------------------------------------------------------------┤@w };
			#SHOW { @C|  @C1)@w Charisma           @C2)@w Constitution           @C3)@w Dexterity                @C|@w };
			#SHOW { @C|  @C4)@w Intelligence       @C5)@w Strength               @C6)@w Wisdom                   @C|@w };
			#SHOW { @C|  @C7)@w Weapon Enhancer    @C8)@w Weapon Specializer     @C9)@w Weapon Un-Specializer    @C|@w };
			#SHOW { @C| @C10)@w The Gainer        @C11)@w Electronics School                                                       @C|@w };
			#SHOW { @C|                                                                              @C|@w };
			#SHOW { @C└------------------------------------------------------------------------------┘@w };
		};

		#ELSEIF {$travelInput1 = "guilds" || %1 = 5}
		{
        		#SHOW { @C┌------------------------------------------------------------------------------┐@w };
		        #SHOW { @C|                          @MGuilds Locations@w                                    @C|@w };
		        #SHOW { @C├------------------------------------------------------------------------------┤@w };
		        #SHOW { @C|  @C1)@w Barbarian         @C2)@w Bard                    @C3)@w Cleric (@REvil@w)            @C|@w };
			#SHOW { @C|  @C4)@w Cleric (@CGood@w)     @C5)@w Cyborg                  @C6)@w Knight (@REvil@w)            @C|@w };
			#SHOW { @C|  @C7)@w Knight (@CGood@w)     @C8)@w Mage                    @C9)@w Mercenary                @C|@w };
			#SHOW { @C| @C10)@w Monk             @C11)@w Physic                 @C12)@w Psionicist               @C|@w };
			#SHOW { @C| @C13)@w Ranger           @C14)@w Thief                  @C@w                             @C|@w };
			#SHOW { @C|                                                                              @C|@w };
        		#SHOW { @C└------------------------------------------------------------------------------┘@w };
		};

		#ELSEIF {$travelInput1 = "underdark" || %1 = 6}
		{
			#SHOW { @C┌------------------------------------------------------------------------------┐@w };
			#SHOW { @C|                        @bUnderdark@w                                              @C|@w };
			#SHOW { @C├------------------------------------------------------------------------------┤@w };
			#SHOW { @C|  @C1)@w Head Shrinker @C2)@w Lizard Caverns  @C3)@w Wyllowwood@w };
			#SHOW { @C|                                                                              @C|@w };
			#SHOW { @C└------------------------------------------------------------------------------┘@w };
		};

		#ELSEIF {$travelInput1 = "all" || %1 = 7}
		{
			#SHOW { @C┌------------------------------------------------------------------------------┐@w };
			#SHOW { @C|                          @w ALL Locations@w                                      @C|@w };
			#SHOW { @C├------------------------------------------------------------------------------┤@w };
			#SHOW { @C|                                                                              @C|@w };
			#SHOW { @C|                          @RUnder Construction@w                                  @C|@w };
			#SHOW { @C|                                                                              @C|@w };
			#SHOW { @C└------------------------------------------------------------------------------┘@w };
		};

		#ELSE {
			#SHOW { @RTravel Warning:@w The value '@M%1@w' is not a valid travel destination. };
		}
	}

#ALIAS {travel} {
	#SHOW { @C┌------------------------------------------------------------------------------┐@w };
	#SHOW { @C|                          @Y Where To Travel@w                                    @C|@w };
	#SHOW { @C├------------------------------------------------------------------------------┤@w };
	#SHOW { @C|                                                                              |@w };
	#SHOW { @C|@w               1) @CPast@w      2) @CFuture@w      3) @MPlanes@w                          @C|@w };
	#SHOW { @C|@w               4) @YTrainers@w  5) @MGuilds@w      6) @bUnderdark@w                       @C|@w }; 
	#SHOW { @C|@w                               7) @wAll@w                                         @C|@w };
	#SHOW { @C|                                                                              @C|@w };
	#SHOW { @C└------------------------------------------------------------------------------┘@w };

}

#NOP ----------------------------------------------------------------------------------------------
#NOP                                      Anchor Start Locations

#TRIGGER {^You are located: %1}
{
	#VAR {currentRoom} {%1};
}

#ALIAS {resettravel} {
	#VAR {travelerror}{0};
	#VAR {travelling}{0};
}

#ALIAS {gotohs} {
	fly;
	where;
	#DELAY {1} {
		#IF {$currentRoom = $myStartingRoomName}
		{
			#VAR {travelling} {1};
			directionsToHolySquare;
		};
		#ELSE {
			#SHOW {@RWarning!@w The current starting room is @RNOT@w your default start room '$myStartingRoomName'!};
			#VAR {travelerror} {1};
			#VAR {travelling} {0};
		}
	}
}

#ALIAS {gotoskull} {
	fly;
    where;
	#DELAY {1} {
		#IF {$currentRoom = $myStartingRoomName}
		{
			#VAR {travelling} {1};
			directionsToSlaveSquare;
		};
	    #ELSE {
	        #SHOW {@RWarning!@w The current starting room is @RNOT@w your default start room '$myStartingRoomName'!};
			#VAR {travelerror} {1};
			#VAR {travelling} {0};
	    }
	}
}

