#TRIGGER {^A huge island of matter is floating here.}
{
    #IF {$findGith = 1}
    {
        #SHOW {@Y***** GITH FOUND! *****@w};
        revoke;
        revoke;
        #VAR {githFound}{1};
        #VAR {findGith}{0};
        enter island;
        challenges area
    };
}

#ALIAS {gotoGith}
{
    #VAR {githFound}{0};
    #VAR {findGith}{1};
    #MATH githX 0;
    #MATH githY 0;
    #MATH githZ 0;
    gotoastral;
    #SHOW {@GOkay!@w Travelling to @YGith@w!};
    #DELAY {2}
    {
        #IF {!$travelerror}
        {
            north;north;north;north;north;exits;
            #NOP (zMUD: trigger "^The Astral Plane" defined at end of file)
        #SHOW {@CWarning!@w Attacked, ceasing search.};
        };
        #ELSE
        {
            resettravel;
        };
    };
}

