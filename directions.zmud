		};
		#ELSE {
			#SHOW {@RWarning!@w The current starting room is @RNOT@w your default start room '$myStartingRoomName'!};
			#VAR {travelerror} {1};
			#VAR {travelling} {0};
		}
	}
}

#ALIAS {gotoastral} {
	fly;
	where;
	#DELAY {1} {
        #IF {$currentRoom = $myStartingRoomName}
        {
            #VAR {travelling} {1};
			directionsToAstralManse;
        };
		#ELSE {
    	#SHOW {@RWarning!@w The current starting room is @RNOT@w your default start room '$myStartingRoomName'!};
            #VAR {travelerror} {1};
            #VAR {travelling} {0};		
		}
	}
}

